{
  "name": "@alexevs/prettier-config",
  "version": "1.0.1",
  "description": "Shared Prettier configuration used across multiple projects.",
  "author": "AlexEvs",
  "homepage": "https://a1exevs.github.io/prettier-config",
  "bugs": {
    "url": "https://github.com/a1exevs/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1exevs/prettier-config.git"
  },
  "keywords": [
    "prettier",
    "config",
    "formatting"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": "./dist/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "prettier": "3.9.6"
  },
  "scripts": {
    "version:major": "ts-node -P scripts/tsconfig.json scripts/increase-version.ts major",
    "version:minor": "ts-node -P scripts/tsconfig.json scripts/increase-version.ts minor",
    "version:patch": "ts-node -P scripts/tsconfig.json scripts/increase-version.ts patch",
    "update-version:major": "./scripts/update-version.sh major",
    "update-version:minor": "./scripts/update-version.sh minor",
    "update-version:patch": "./scripts/update-version.sh patch",
    "build": "rimraf dist && tsc",
    "format": "yarn build && prettier --config ./dist/index.js --write \"{src,linter,tests,scripts}/**/*.ts\"",
    "lint": "eslint --config eslint.config.ts \"{src,linter,tests,scripts}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --config eslint.config.ts --fix \"{src,,linter,tests,scripts}/**/*.{ts,tsx}\"",
    "publish-package": "npm publish --access public",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "fs": "0.0.1-security",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.5.1",
    "path": "0.12.7",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "yarn@4.18.0"
}
