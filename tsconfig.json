{
  "compilerOptions": {
    "target": "es2021",
    "module": "nodenext",
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "./dist",
    "strict": true,
    "declaration": false, /**don't emit d.ts**/
    "alwaysStrict": true,
    "importHelpers": true,
    "moduleResolution": "nodenext",
    "typeRoots": ["node_modules/@types", "types"],
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "linter",
    "scripts",
    ".coverage",
    "**/specs/*",
    "**/*.spec.ts",
    "**/*.spec.unit.ts"
  ]
}
